  "grammar_notes": [
    {
      "text": "The prefix 'ya-' is used to indicate the action of losing, as in 'ya- (yours)' which means 'lose'. This can be applied to create new forms indicating loss.",
      "source_page": null,
      "source_page_end": null,
      "source_excerpt": "lose= ya- (yours)",
      "grammar_lineage": "woccon_attested",
      "source_chunk_index": 0,
      "_chunk_page_start": null,
      "_chunk_page_end": null
    }
  ],
  "pronunciation_notes": [],
  "cultural_notes": [
    {
      "text": "The game of Rock, Paper (Skins), Scissors is adapted from Dr. Roberts and uses Woccon terms for its components: 'itte terraugh' for rock, 'teep' for paper/skins, and 'toc koor' for scissors.",
      "source_page": null,
      "source_page_end": null,
      "source_excerpt": "Rock: itte terraugh Paper/skins: teep Scissors: toc koor",
      "source_chunk_index": 0,
