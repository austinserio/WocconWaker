# Azure Container Apps: API + control panel static assets (Foundry mode).
# Set LOCAL_LLM=false and FOUNDRY_* env vars in the container.
FROM node:20-alpine AS panel-build
WORKDIR /panel
COPY panel/package.json panel/package-lock.json* ./
RUN npm install
COPY panel/ ./
RUN npm run build

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY --from=panel-build /panel/dist ./panel/dist

EXPOSE 8000

ENV WOCCON_MODE=server
ENV PORT=8000
ENV DATABASE_URL=sqlite:///./data/woccon.db
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
