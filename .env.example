# Copy to .env and fill in values: cp .env.example .env
# .env is gitignored. See CLAUDE.md for full descriptions.

# --- App / Messenger ---
WOCCON_MODE=server
PORT=8000
VERIFY_TOKEN=
PAGE_ACCESS_TOKEN=
ENABLE_TYPING_INDICATORS=false

# --- LLM: pick one path (local Ollama vs llama-server vs Foundry vs Anthropic) ---
LOCAL_LLM=false
# Native Ollama (legacy): http://127.0.0.1:11434
# Qwen3.6 multimodal (UIC, Policy Tracker pattern): http://100.71.124.8:8080/v1
OLLAMA_URL=http://127.0.0.1:8080/v1
# Unified text + vision (llama-server serves Qwen3.6-27B Q8 + mmproj on :8080)
OLLAMA_MODEL=Qwen3.6-27B-Q8_0.gguf
OLLAMA_VISION_MODEL=Qwen3.6-27B-Q8_0.gguf
# Optional llama-server overrides (same as Policy Tracker deploy/llm-cutover.env.snippet)
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=ollama
# LLM_REASONING=off
# Legacy Ollama-only split (before Qwen3.6 cutover):
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:32b
# OLLAMA_VISION_MODEL=qwen2.5vl:32b
# Anthropic is never used unless ALLOW_ANTHROPIC_FALLBACK=true (prevents accidental API spend)
ALLOW_ANTHROPIC_FALLBACK=false

FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_VERSION=2024-10-21
FOUNDRY_INFERENCE_API_VERSION=2024-05-01-preview
AZURE_AI_ENDPOINT=
AZURE_INFERENCE_CREDENTIAL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# PDF vision OCR fallback (scanned PDFs; uses OLLAMA_VISION_MODEL when LOCAL_LLM=true,
# otherwise requires ANTHROPIC_API_KEY + ALLOW_ANTHROPIC_FALLBACK=true)
PDF_OCR_ENABLED=true
PDF_OCR_MIN_CHARS_PER_PAGE=50
PDF_OCR_DPI=200
# PDF_OCR_NUM_PREDICT=2048              # max tokens per OCR page (default 2048)
# PDF_OCR_UNLOAD_TEXT_MODEL=false       # default skip when OLLAMA_MODEL == OLLAMA_VISION_MODEL
# PDF_OCR_UNLOAD_VISION_MODEL=false     # default skip for unified model (keep loaded for extract)
# PDF_OCR_MODEL=          # optional override; defaults to ANTHROPIC_MODEL
# Scanned journals often embed an OCR text layer that reads as clean English but has dropped
# every diacritic, which a character-count check cannot detect. These re-OCR image-backed
# pages whose text layer has no phonetic characters.
# PDF_OCR_RECHECK_ASCII_SCANS=true      # set false to trust embedded scan text layers as-is
# PDF_OCR_SCAN_IMAGE_COVERAGE=0.5       # min page fraction covered by one image to count as a scan

# Catawba is a distinct language used as comparative evidence; its vocabulary must never be
# merged into the Woccon lexicon. Documents are classified by Drive folder name (pipe-separated,
# matched on whole path segments, case-insensitive).
# CATAWBA_FOLDER_NAMES=Catawba Language
# CONTEXT_FOLDER_NAMES=Catawba Nation - Context
# CATAWBA_STAGING_DIR=woccon_language/catawba_staging

# Optional: override model for admin re-extract / backfill (defaults to ANTHROPIC_MODEL, etc.)
# REEXTRACT_MODEL=

# --- Models (Docker / GPU paths) ---
LLAMA_MODEL_PATH=/workspace/models/llama3-8b
T5_MODEL_PATH=/workspace/models/t5-base

# --- Language data overrides ---
# Messenger/assistant runtime source: panel_db (default) reads canonical tables from DATABASE_URL.
# Unified JSON is written on Commit as backup only. Use json mode to load stale unified files instead.
# WOCCON_LANGUAGE_SOURCE=panel_db
# WOCCON_DICTIONARY_PATH=woccon_language/dictionary.json
# WOCCON_RULES_PATH=woccon_language/rules.json

# --- Drive ingest (required folder id for drive_ingest.py) ---
GOOGLE_APPLICATION_CREDENTIALS=
DRIVE_FOLDER_ID=
# DRIVE_STAGING_DIR=          # e.g. woccon_language/drive_staging_local for local-model re-runs
# DRIVE_INGEST_LIMIT=
# DRIVE_INGEST_FILTER=
# DRIVE_INGEST_FORCE_FULL=1   # re-fetch and re-extract all files (ignore sync_state)
# SKIP_EXTRACTION=1           # fetch/archive only, no LLM extraction
# EXTRACTION_FOCUS=general    # general | vocabulary | grammar | pronunciation | culture
# GRAMMAR_LINEAGE=            # woccon_attested | proto_catawban | proto_siouan_catawban | … (grammar focus only)
# INGEST_SOURCES_DIR=data/ingest_sources       # raw PDF/Docs archive (gitignored under data/)
# INGEST_TEXT_CACHE_DIR=data/ingest_text_cache # post-OCR text cache
# EXTRACT_PARALLEL_WORKERS=2                   # parallel LLM chunk workers (default 2 when LOCAL_LLM=true)
# EXTRACT_NUM_PREDICT=4096                     # max output tokens per chunk
# Hybrid list-doc extract (English-Woccon, Documentation of Woccon Words Lawson block)
# HYBRID_LIST_EXTRACT=1                        # default on; set 0 to disable parser merge
# HYBRID_LIST_DOCS=English-Woccon,Documentation of Woccon Words  # optional explicit allowlist
# HYBRID_LLM_LEXICON=1                         # include LLM lexicon in hybrid merge (default on)
# EXTRACT_COMPLETENESS_FAIL=1                  # fail ingest when parser candidates missing from staging
# HYBRID_LLM_LEXICON=1                         # set 0 for parser-only lexicon (LLM notes only)
# OLLAMA_KEEP_ALIVE=0                          # default: unload after idle (multi-app)
# OLLAMA_KEEP_ALIVE=10m                        # optional during long batch ingest runs
# UIC server: set OLLAMA_NUM_PARALLEL=3 in systemd (match EXTRACT_PARALLEL_WORKERS)
# OLLAMA_VISION_TIMEOUT=900                    # seconds per vision OCR page (default 900)
# PDF_OCR_PARALLEL_WORKERS=2                   # parallel OCR pages (default 1); use 2 after VRAM unload with 32b vision
# GOOGLE_DRIVE_API_KEY=

# --- Admin API ---
INGEST_DRIVE_SECRET=

# --- Control panel (JWT + SQLite/Postgres) ---
# Local dev: SQLite (default). Production Container App uses Postgres (see scripts/setup-azure-postgres.sh).
DATABASE_URL=sqlite:///./data/woccon.db
# Azure Postgres (prod + migrate/pull scripts). Not used by the app when DATABASE_URL is sqlite.
# POSTGRES_DATABASE_URL=postgresql+psycopg://wocconadmin:<password>@woccon-pg.postgres.database.azure.com:5432/woccon?sslmode=require
# One-time migration source override (defaults to DATABASE_URL when sqlite, else ./data/woccon.db)
# SQLITE_SOURCE_URL=sqlite:///./data/woccon.db
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
PANEL_ADMIN_EMAIL=admin@woccon.local
PANEL_ADMIN_PASSWORD=changeme
PANEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL for invite/reset links (prod: https://your-app.azurecontainerapps.io)
PANEL_PUBLIC_BASE_URL=http://localhost:5173
# Email: log = print links to server stdout (dev); smtp = send via relay
EMAIL_MODE=log
# SMTP (prod — SendGrid, M365, etc.; see scripts/setup-panel-email-azure-cli.sh)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=                    # Gmail app password: use quotes if it contains spaces, e.g. SMTP_PASSWORD="abcd efgh ijkl mnop"
# SMTP_FROM=noreply@yourdomain.com
# SMTP_USE_TLS=true
# INVITE_EXPIRE_HOURS=168
# PASSWORD_RESET_EXPIRE_HOURS=24
WOCCON_UPLOAD_DIR=data/uploads
DUPLICATE_THRESHOLD=0.85
# WOCCON_DICTIONARY_PATH=woccon_language/dictionary_unified.json
# WOCCON_RULES_PATH=woccon_language/rules_unified.json
# Import full unified community data on empty canonical tables (default false = Lawson-only rebuild)
PANEL_IMPORT_COMMUNITY=false

# Definitive base vocabulary (Google Doc)
WOCCON_BASE_VOCAB_DRIVE_ID=1GeBNwmjOCONZprzcrxg1IMlx9i2ILJWqfuPmKC5hIzg
# Pronunciation sketch doc (merged onto base vocab when available)
WOCCON_PRONUNCIATION_DRIVE_ID=18zrEOG7RktcHny5agvUm2WTwIOXBAg3asTOOBtCQd90
# WOCCON_FUZZY_THRESHOLD=0.88
# WOCCON_BASE_VOCAB_DEDUPE_THRESHOLD=0.85

# --- Pronunciation audio (Kokoro CPU batch) ---
# PRONUNCIATION_AUDIO_DIR=data/pronunciation_audio
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=0.8
# KOKORO_LANG_CODE=a
# Generate clips: python3.12 -m venv .venv-tts && source .venv-tts/bin/activate && pip install -r requirements-tts.txt
# HF_HOME=data/hf_cache python scripts/generate_pronunciation_audio.py --sample-only
# HF_HOME=data/hf_cache python scripts/generate_pronunciation_audio.py --force --staging woccon_language/drive_staging/English-Woccon.json

# --- Local dev: tunnel / docs (optional; used by docs and helper scripts) ---
# Public base URL for webhooks, e.g. https://woccon-dev.example.com
PUBLIC_WEBHOOK_BASE_URL=
# Hostname for cloudflared ingress, e.g. woccon-dev.example.com
CLOUDFLARE_TUNNEL_HOSTNAME=
# Tunnel name (cloudflared tunnel create <name>) when not using cloudflared.yml
CLOUDFLARE_TUNNEL_NAME=woccon-dev
# Tunnel UUID for setup-tunnel-dns.sh (cloudflared tunnel list)
CLOUDFLARE_TUNNEL_ID=
# Production Container App URL for Messenger callback docs (optional)
AZURE_CONTAINER_APP_WEBHOOK_URL=

# --- Azure CLI helper scripts (GPU deploy, Foundry setup, cleanup) ---
AZURE_SUBSCRIPTION_ID=
# Main Container Apps resource group (deploy-container-app-gpu, delete-all-azure-resources)
AZURE_RESOURCE_GROUP=
# Production in Central US (co-located with Postgres). East stack kept until teardown.
AZURE_LOCATION=centralus
AZURE_ACR_NAME=wocconwakerwicus
AZURE_CONTAINER_APP_ENV=wocconwaker-env-central
AZURE_CONTAINER_APP_NAME=wocconwaker-app-central
# Legacy East US 2 names (for scripts/teardown-east-resources.sh only)
# AZURE_EAST_APP_NAME=wocconwaker-app
# AZURE_EAST_ENV_NAME=wocconwaker-env
# AZURE_EAST_ACR_NAME=wocconwakerwi
# Optional overrides for deploy-container-app-gpu.sh
# AZURE_LOCATION=eastus
# AZURE_CONTAINER_APP_ENV=wocconwaker-env-gpu
# AZURE_CONTAINER_APP_NAME=wocconwaker-app-gpu
# GPU multiregion / spot VM scripts
AZURE_RESOURCE_GROUP_GPU=

# --- Cloudflare (cleanup-tunnel-dns.sh) ---
CLOUDFLARE_API_TOKEN=
# Zone name containing the stray record to remove (script-specific)
CLOUDFLARE_CLEANUP_ZONE=
# Record name to match for cleanup (script-specific)
CLOUDFLARE_WRONG_RECORD_NAME=
